# Public browser config
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only: never expose service role or payment/mail secrets in NEXT_PUBLIC variables
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
ADMIN_EMAIL=you@example.com

# Paystack test mode keys (use test keys until launch)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxx

# Mailgun
MAILGUN_API_KEY=key-xxxxxxxx
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=ODC VICTORS <orders@mg.example.com>

# Optional: Google OAuth is configured in Supabase Auth provider settings.
# Add Google Client ID and Secret in Supabase Dashboard; redirect URI is shown there.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
